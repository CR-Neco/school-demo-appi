{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AppI: Backend starten",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": ["-m", "uvicorn", "appi.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "options": {"cwd": "${workspaceFolder}/backend"},
      "problemMatcher": []
    },
    {
      "label": "AppI: Backend-Tests lokal",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": ["-m", "pytest", "-q"],
      "options": {"cwd": "${workspaceFolder}/backend"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
